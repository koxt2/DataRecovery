<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="MapHealthView" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkStack" id="stack">
        <property name="vexpand">true</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="AdwStatusPage">
                <property name="icon-name">drive-harddisk-symbolic</property>
                <property name="title">No map file loaded</property>
                <property name="description">Open a ddrescue map file to see the health of the drive.</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">content</property>
            <property name="child">
              <object class="AdwOverlaySplitView">
                <property name="sidebar-position">end</property>
                <property name="sidebar-width-fraction">0.35</property>
                <property name="max-sidebar-width">460</property>
                <property name="content">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkFrame">
                        <property name="margin-bottom">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-top">12</property>
                        <property name="child">
                          <object class="DataRecoveryMapGrid" id="grid">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <property name="width-request">240</property>
                            <property name="height-request">180</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="margin-bottom">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-start">12</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Cell size</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScale" id="cell_size_scale">
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">4</property>
                                <property name="upper">40</property>
                                <property name="step-increment">1</property>
                                <property name="value">12</property>
                              </object>
                            </property>
                            <property name="hexpand">true</property>
                            <property name="orientation">horizontal</property>
                            <property name="draw-value">false</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Blend colours</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSwitch" id="blend_switch">
                            <property name="valign">center</property>
                            <property name="tooltip-text">Off: a cell shows its worst status. On: colours are averaged by size.</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="sidebar">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="width-request">340</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Key</property>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Non-tried  (?)</property>
                                <property name="subtitle">Not yet attempted</property>
                                <child type="prefix">
                                  <object class="DataRecoveryStatusSwatch" id="non_tried_swatch"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="non_tried_value">
                                    <property name="xalign">1</property>
                                    <property name="css-classes">dim-label,numeric</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Non-trimmed  (*)</property>
                                <property name="subtitle">Failed block edges not yet trimmed</property>
                                <child type="prefix">
                                  <object class="DataRecoveryStatusSwatch" id="non_trimmed_swatch"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="non_trimmed_value">
                                    <property name="xalign">1</property>
                                    <property name="css-classes">dim-label,numeric</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Non-scraped  (/)</property>
                                <property name="subtitle">Trimmed, not yet scraped</property>
                                <child type="prefix">
                                  <object class="DataRecoveryStatusSwatch" id="non_scraped_swatch"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="non_scraped_value">
                                    <property name="xalign">1</property>
                                    <property name="css-classes">dim-label,numeric</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Bad sector  (-)</property>
                                <property name="subtitle">Read failed; unrecoverable so far</property>
                                <child type="prefix">
                                  <object class="DataRecoveryStatusSwatch" id="bad_swatch"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="bad_value">
                                    <property name="xalign">1</property>
                                    <property name="css-classes">dim-label,numeric</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Finished  (+)</property>
                                <property name="subtitle">Successfully rescued</property>
                                <child type="prefix">
                                  <object class="DataRecoveryStatusSwatch" id="finished_swatch"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="finished_value">
                                    <property name="xalign">1</property>
                                    <property name="css-classes">dim-label,numeric</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Summary</property>
                            <child>
                              <object class="AdwActionRow" id="size_row">
                                <property name="title">Domain size</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="rescued_row">
                                <property name="title">Rescued</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="errors_row">
                                <property name="title">Bad sectors</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="phase_row">
                                <property name="title">Current phase</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="pos_row">
                                <property name="title">Current position</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="blocks_row">
                                <property name="title">Blocks in map</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="cmd_row">
                                <property name="title">Command line</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="subtitle-lines">3</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="file_row">
                                <property name="title">Map file</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="subtitle-lines">2</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Hovered cell</property>
                            <child>
                              <object class="AdwActionRow" id="hover_row">
                                <property name="title">Hover over the grid</property>
                                <property name="subtitle"> </property>
                                <property name="subtitle-lines">6</property>
                                <property name="css-classes">property</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
