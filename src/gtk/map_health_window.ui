<?xml version='1.0' encoding='UTF-8'?>
<!-- Created with Cambalache 1.0.3 -->
<interface>
  <!-- interface-name map_health_window.ui -->
  <requires lib="Adw" version="1.0"/>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.7"/>
  <template class="MapHealthWindow" parent="AdwDialog">
    <property name="child">
      <object class="AdwToolbarView">
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="GtkBox">
                <child>
                  <object class="GtkBox">
                    <property name="margin-bottom">10</property>
                    <property name="margin-end">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-top">10</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox">
                        <property name="halign">center</property>
                        <property name="spacing">10</property>
                        <property name="vexpand">True</property>
                        <child>
                          <object class="GtkFrame">
                            <property name="child">
                              <object class="GtkBox" id="grid_holder">
                                <property name="hexpand">false</property>
                                <property name="margin-bottom">5</property>
                                <property name="margin-end">5</property>
                                <property name="margin-start">5</property>
                                <property name="margin-top">5</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkFrame">
                            <property name="child">
                              <object class="GtkBox" id="overview_holder">
                                <property name="margin-bottom">5</property>
                                <property name="margin-end">5</property>
                                <property name="margin-start">5</property>
                                <property name="margin-top">5</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkBox">
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Zoom</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScale" id="zoom_scale">
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="lower">0</property>
                                    <property name="step-increment">2</property>
                                    <property name="upper">100</property>
                                    <property name="value">0</property>
                                  </object>
                                </property>
                                <property name="draw-value">false</property>
                                <property name="hexpand">true</property>
                                <property name="orientation">horizontal</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="halign">start</property>
                            <child>
                              <object class="GtkLabel" id="zoom_label">
                                <property name="css-classes">dim-label,numeric</property>
                                <property name="ellipsize">end</property>
                                <property name="hexpand">True</property>
                                <property name="label">
</property>
                                <property name="width-chars">0</property>
                                <property name="xalign">1</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="margin-bottom">10</property>
                    <property name="margin-end">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-top">10</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="valign">center</property>
                            <child>
                              <object class="AdwActionRow">
                                <property name="subtitle">Not yet attempted</property>
                                <property name="title">Non-tried  (?)</property>
                                <child type="prefix">
                                  <object class="GtkBox" id="non_tried_swatch_holder"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="non_tried_value">
                                    <property name="css-classes">dim-label,numeric</property>
                                    <property name="xalign">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="subtitle">Failed block edges not yet trimmed</property>
                                <property name="title">Non-trimmed  (*)</property>
                                <child type="prefix">
                                  <object class="GtkBox" id="non_trimmed_swatch_holder"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="non_trimmed_value">
                                    <property name="css-classes">dim-label,numeric</property>
                                    <property name="xalign">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="subtitle">Trimmed, not yet scraped</property>
                                <property name="title">Non-scraped  (/)</property>
                                <child type="prefix">
                                  <object class="GtkBox" id="non_scraped_swatch_holder"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="non_scraped_value">
                                    <property name="css-classes">dim-label,numeric</property>
                                    <property name="xalign">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="subtitle">Read failed; unrecoverable so far</property>
                                <property name="title">Bad sector  (-)</property>
                                <child type="prefix">
                                  <object class="GtkBox" id="bad_swatch_holder"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="bad_value">
                                    <property name="css-classes">dim-label,numeric</property>
                                    <property name="xalign">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="subtitle">Successfully rescued</property>
                                <property name="title">Finished  (+)</property>
                                <child type="prefix">
                                  <object class="GtkBox" id="finished_swatch_holder"/>
                                </child>
                                <child type="suffix">
                                  <object class="GtkLabel" id="finished_value">
                                    <property name="css-classes">dim-label,numeric</property>
                                    <property name="xalign">1</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="valign">center</property>
                            <child>
                              <object class="AdwActionRow" id="size_row">
                                <property name="css-classes">property</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="title">Domain size</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="rescued_row">
                                <property name="css-classes">property</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="title">Rescued</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="errors_row">
                                <property name="css-classes">property</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="title">Bad sectors</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="file_row">
                                <property name="css-classes">property</property>
                                <property name="subtitle-lines">2</property>
                                <property name="subtitle-selectable">true</property>
                                <property name="title">Map file</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="vexpand">True</property>
                            <child>
                              <object class="AdwActionRow" id="hover_row">
                                <property name="css-classes">property</property>
                                <property name="subtitle"> </property>
                                <property name="subtitle-lines">6</property>
                                <property name="title">Hover over the grid</property>
                                <property name="valign">start</property>
                                <property name="vexpand">True</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
      </object>
    </property>
    <property name="content-height">650</property>
    <property name="content-width">760</property>
    <property name="title">Drive Health</property>
    <property name="vexpand">True</property>
  </template>
</interface>
